<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The native engine's Monitor runs as a foreground service so it keeps
         working with the screen off. It starts only from the visible live
         screen, after the shell's disclosure and permission prompts, never
         from the background or at boot. The camera and microphone run only
         while a Viewer is connected. No wake lock of the app's own is held. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name=".nativeapp.MonitorService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
